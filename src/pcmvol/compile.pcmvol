#!/bin/bash

# NOTE (yi-hack-v5 port): the hisiv300 toolchain (/opt/arm-hisiv300-linux)
# is not obtainable, so this uses the Debian arm-linux-gnueabi toolchain.
# The binary is linked statically: the camera runs uClibc, so a
# glibc-dynamic binary would not run there.
export CROSSPATH=/usr/bin
export PATH=${PATH}:${CROSSPATH}

export TARGET=arm-linux-gnueabi
export CROSS=arm-linux-gnueabi
export BUILD=x86_64-pc-linux-gnu

export CROSSPREFIX=${CROSS}-

export STRIP=${CROSSPREFIX}strip
export CXX=${CROSSPREFIX}g++
export CC=${CROSSPREFIX}gcc
export LD=${CROSSPREFIX}ld
export AS=${CROSSPREFIX}as
export AR=${CROSSPREFIX}ar

SCRIPT_DIR=$(cd `dirname $0` && pwd)
cd $SCRIPT_DIR

cd pcmvol || exit 1

make clean
make -j $(nproc) || exit 1

mkdir -p ../_install/bin || exit 1

cp ./pcmvol ../_install/bin || exit 1

${STRIP} ../_install/bin/* || exit 1
