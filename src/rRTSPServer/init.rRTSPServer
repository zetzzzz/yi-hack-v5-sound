#!/bin/bash

ARCHIVE=live.2023.01.19.tar.gz
FDKAAC_VER=2.0.1
ARCHIVE_FDKAAC=v${FDKAAC_VER}.tar.gz

# NOTE (yi-hack-v5 port): the hisiv300 toolchain (/opt/arm-hisiv300-linux)
# is not obtainable, so this uses the Debian arm-linux-gnueabi toolchain
# (gcc-arm-linux-gnueabi + g++-arm-linux-gnueabi). The tone test proved
# Debian-built static ARM binaries run on the Hi3518ev200 camera.
# To go back to hisiv300, set CROSS=arm-hisiv300-linux-uclibcgnueabi and
# restore /opt/arm-hisiv300-linux/bin to PATH.
export TARGET=arm-linux-gnueabi
export CROSS=arm-linux-gnueabi
export BUILD=x86_64-pc-linux-gnu

export CROSSPREFIX=${CROSS}-

export STRIP=${CROSSPREFIX}strip
export CXX=${CROSSPREFIX}g++
export CC=${CROSSPREFIX}gcc
export LD=${CROSSPREFIX}ld
export AS=${CROSSPREFIX}as
export AR=${CROSSPREFIX}ar

SCRIPT_DIR=$(cd `dirname $0` && pwd)
cd $SCRIPT_DIR

rm -rf ./_install
rm -rf ./live
rm -rf ./fdk-aac

# fdk-aac (needed by the backchannel ADTS2PCMFileSink: AAC -> PCM decode)
if [ ! -f ${ARCHIVE_FDKAAC} ]; then
    wget https://github.com/mstorsjo/fdk-aac/archive/${ARCHIVE_FDKAAC}
fi
tar zxvf ${ARCHIVE_FDKAAC}
mv fdk-aac-${FDKAAC_VER} fdk-aac
cd fdk-aac

./autogen.sh || exit 1

# NOTE: MStar's init passes -mcpu=cortex-a7 -mfpu=neon-vfpv4 plus its
# toolchain sysroot paths. Those are Allwinner-toolchain specific and are
# deliberately NOT used here: the Debian compiler's generic ARM target is
# enough for the AAC decoder and keeps the build independent of any
# vendor toolchain.
./configure CC=arm-linux-gnueabi-gcc \
    --prefix=$SCRIPT_DIR/fdk-aac/_install \
    CFLAGS="-g -Os -ffunction-sections -fdata-sections" \
    AR=arm-linux-gnueabi-ar \
    RANLIB=arm-linux-gnueabi-ranlib \
    --host=arm-linux-gnueabi \
    --disable-shared \
    || exit 1

cd ..

# live555
if [ ! -f $ARCHIVE ]; then
    wget https://download.videolan.org/pub/contrib/live555/$ARCHIVE
fi
tar zxvf $ARCHIVE

patch -p0 < rRTSPServer.patch
#patch -p0 < rRTSPServer2.patch
# NOTE: rRTSPServer.patch also carries a 64-bit time_t fix for
# ServerMediaSession::generateSDPDescription(): live555 2023 formats
# struct timeval with "%ld", but the Debian glibc (armel, time64) has
# 64-bit tv_sec/tv_usec, which misaligns the varargs and segfaults
# snprintf on every DESCRIBE. Fixed with "%lld" + (long long) casts.
# (Harmless for 32-bit time_t toolchains such as hisiv300/uClibc.)
# friend.patch (ported from yi-hack-MStar): makes RTPSource::
# curPacketRTPTimestamp() public in live.2023.01.19, as the backchannel
# OnDemandServerMediaSubsession_BC::startStream() needs it.
patch -p0 < friend.patch
# live555-reuseport-fix.patch (yi-hack-v5 fork, 2026-11-17): remove the
# SO_REUSEPORT setsockopt (fails ENOPROTOOPT on the camera's kernel
# 3.4.35 and wedges SETUP), bound the port-allocation loops, and answer
# 500 on a failed getStreamParameters(). Without this, a re-run of this
# script (rm -rf ./live + re-extract) would silently lose the fix.
patch -p0 < live555-reuseport-fix.patch || exit 1

cd live || exit 1

./genMakefiles linux-cross
cp -f ../Makefile.rRTSPServer Makefile
cp -rf ../src .
cp -rf ../include .
